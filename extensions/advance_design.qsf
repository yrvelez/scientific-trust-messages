  {
   "SurveyID": "SV_filedrawer00000",
   "Element": "SQ",
   "PrimaryAttribute": "QID9",
   "SecondaryAttribute": "Thank you. This study examined how different kinds of messages affect views of s",
   "TertiaryAttribute": null,
   "Payload": {
    "QuestionText": "Thank you. This study examined how different kinds of messages affect views of science. The videos and text presented real, general discussions of science; none was meant to mislead. You will be invited to a brief follow-up in about one week.",
    "DataVisibility": {
     "Private": false,
     "Hidden": false
    },
    "Configuration": {
