{
 "id": "generalizability_conditional",
 "kind": "boundary",
 "title": "Do the small positive videos replicate across samples and baseline trust?",
 "rationale": "Videos 12, 15 and 20 raised trust by about 0.06 (Video 12 CI [0.005, 0.123]; Video 15 CI [0.014, 0.112]) among 32 uncorrected tests, with intervals near zero. A confirmatory replication in a new panel with few tests, plus moderation by baseline trust and party, tests whether the effects are real and where they hold.",
 "contribution": "Provides a pre-registered, multiplicity-limited replication of three small positive video effects in a non-Lucid sample and tests moderation by baseline trust and party.",
 "limitations": [
  "Different vendors differ in sample composition, so a failure to replicate may reflect the panel, not a false positive.",
  "Trust is measured immediately after exposure, so durability is unknown.",
  "Moderator tests are underpowered at about 4,400 per arm for small interactions.",
  "Video 20's title is unrecorded and coding is post hoc."
 ],
 "design": {
  "title": "Replication of three positive videos by baseline trust and party",
  "overview": "US adults from a non-Lucid panel complete pre-treatment trust and party questions, then are randomised to control, Video 12, Video 15, Video 20, or the strongest-effect comparison video ('Can You Trust Science Too Much?'). Post-treatment trust is measured with the source items. Three directional tests use a single correction, with arm-by-trust and arm-by-party interactions.",
  "hypothesis": "Videos 12, 15 and 20 each raise post-treatment trust in science relative to control by about 0.06 points; effects differ by baseline trust (low vs high) and party identification.",
  "primaryOutcome": "Post-treatment trust in science, mean of the 6 items with items 4-6 reverse-coded, adjusted for pre-treatment trust.",
  "comparison": "Each of Videos 12, 15 and 20 vs control (three one-sided tests, Holm-corrected); exploratory arm x baseline trust (median split) and arm x party interactions; the comparison video is a benchmark for the negative effect.",
  "population": "US adults aged 18+ from an online panel other than Lucid, about 22,000 total (about 4,400 per arm across 5 arms).",
