  "ambiguities": [
    {
      "hypothesis": "H1",
      "field": "estimator.weights",
      "kind": "interpretation",
      "pap_text": "Regression weighted to account for differential probabilities of treatment assignment.",
      "interpretation": "ipw = 1 / the arm's share among the responses assigned in the same batch",
      "alternatives": [
        "1 / the probability the assignment server used"
      ],
      "reason": "the per-batch probabilities came from the authors' server and were not stored with the responses"
    },
    {
      "hypothesis": "H1",
      "field": "estimator.kind",
      "kind": "interpretation",
      "pap_text": "Covariate adjusted regression with basic demographic characteristics (5yvh9); we have chosen to adjust for covariates using the Lin (2013) estimator (amendment 5wr2k).",
      "interpretation": "Lin (2013) estimator: arm indicators interacted with mean-centred covariates, HC2",
      "alternatives": [
        "OLS with additive covariates"
      ],
      "reason": "the amendment adopts Lin's estimator for the covariate-adjusted ATEs"
    },
    {
      "hypothesis": "H1",
      "field": "estimator.covariates",
      "kind": "interpretation",
      "pap_text": "age, education, race, political party, and pre-treatment trust in science",
      "interpretation": "age and education (Lucid codes) as numbers; race as white and Hispanic indicators; party as Democrat and Republican indicators (leaners included); pre_trust",
      "alternatives": [
        "full categorical dummies"
      ],
      "reason": "the registration names the covariates but not their coding, and full dummies interacted with 32 arms would leave too few respondents per parameter"
    },
    {
      "hypothesis": "H1",
      "field": "outcome",
      "kind": "interpretation",
      "pap_text": "6-item trust in science scale; summative scales will be used.",
      "interpretation": "mean of the six items with the three negatively worded items reverse-coded (a summative scale divided by six)",
      "alternatives": [
        "sum of the items"
      ],
      "reason": "three items are worded against trust; the mean keeps the 1-5 response scale"
    },
    {
      "hypothesis": "H1",
      "field": "estimator.covariates",
      "kind": "interpretation",
      "pap_text": "In the event of significant trends in the control group, will include batch fixed effects.",
      "interpretation": "batch fixed effects are run as a robustness check",
      "alternatives": [],
      "reason": "conditional in the registration"
    },
    {
      "hypothesis": "all",
      "field": "analysis",
      "kind": "interpretation",
      "pap_text": "Randomization inference test of no treatment effect across all arms; posterior probability of the best-performing arm.",
      "interpretation": "not computed by this pipeline; the arm-level estimates are reported",
      "alternatives": [],
      "reason": "the pipeline estimates registered regressions only"
    }
